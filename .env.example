# Copy to .env.local and fill in what you need. Every value is optional:
# with none set, the site reads the public Prismic repo and uses the mock checkout.

# Public origin, used for canonical URLs, Open Graph images, the sitemap and
# Stripe return URLs. Netlify's URL is used when this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prismic. Repository defaults to slicemachine.config.json ("suburbia-solo").
# NEXT_PUBLIC_PRISMIC_ENVIRONMENT=suburbia-solo
# Only needed if the repository's API is set to private.
# PRISMIC_ACCESS_TOKEN=
# Shared secret for the Prismic webhook that calls POST /api/revalidate.
# The route refuses every request until this is set.
PRISMIC_WEBHOOK_SECRET=
# Set to 1 to read content from src/fixtures instead of Prismic (offline / tests).
# PRISMIC_FIXTURES=1

# Stripe. Leave empty for the clearly-labelled mock checkout.
# Only TEST keys (sk_test_... or rk_test_...) are accepted; live keys are refused.
STRIPE_SECRET_KEY=

# Display + Stripe currency (ISO code). Defaults to cad.
# NEXT_PUBLIC_SHOP_CURRENCY=cad
